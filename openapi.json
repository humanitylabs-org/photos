{
  "openapi": "3.1.0",
  "info": {
    "title": "Photos (Wizard page API)",
    "version": "0.1.0",
    "description": "The Wizard page's own API at /photos/api. Same-origin, owner's shell origins only. Immich's API (https://api.immich.app) is served unchanged at /api on the same port."
  },
  "paths": {
    "/photos/api/status": {
      "get": {
        "summary": "Immich, agent, library, background work and import status",
        "responses": {
          "200": {
            "description": "status"
          }
        }
      }
    },
    "/photos/api/import": {
      "get": {
        "summary": "Takeout import state, files in the drop folder, options, log tail",
        "responses": {
          "200": {
            "description": "import"
          }
        }
      }
    },
    "/photos/api/import/options": {
      "get": {
        "summary": "Import options",
        "responses": {
          "200": {
            "description": "options"
          }
        }
      },
      "post": {
        "summary": "Change import options",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "include_archived": {
                    "type": "boolean"
                  },
                  "include_partner": {
                    "type": "boolean"
                  },
                  "sync_albums": {
                    "type": "boolean"
                  },
                  "include_trashed": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "options"
          }
        }
      }
    },
    "/photos/api/import/start": {
      "post": {
        "summary": "Start importing every Takeout file in Photos/Import",
        "responses": {
          "200": {
            "description": "started or why not"
          }
        }
      }
    },
    "/photos/api/connect": {
      "post": {
        "summary": "Create the agent's narrow Immich API key from the signed-in owner's Immich session",
        "responses": {
          "200": {
            "description": "connected"
          },
          "401": {
            "description": "sign in to Immich first"
          },
          "403": {
            "description": "not the Immich admin"
          }
        }
      }
    },
    "/photos/api/disconnect": {
      "post": {
        "summary": "Forget (and revoke, when signed in) the agent's key",
        "responses": {
          "200": {
            "description": "disconnected"
          }
        }
      }
    },
    "/api/switches": {
      "get": {
        "summary": "wizard.app-switches/1",
        "responses": {
          "200": {
            "description": "switches"
          }
        }
      },
      "post": {
        "summary": "Set a switch",
        "responses": {
          "200": {
            "description": "switches"
          }
        }
      }
    },
    "/healthz": {
      "get": {
        "summary": "Front health and whether Immich answers",
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      }
    }
  }
}
