{
  "openapi": "3.1.0",
  "info": {
    "title": "Photos (Wizard page API)",
    "version": "0.2.0",
    "description": "The Wizard page's own API at /photos/api. Same-origin, owner's shell origins only. Immich's API (https://api.immich.app) is served unchanged at /api on the same port."
  },
  "paths": {
    "/photos/api/status": {
      "get": {
        "summary": "Immich, agent, library, background work and import status",
        "responses": {
          "200": {
            "description": "status"
          }
        }
      }
    },
    "/photos/api/import": {
      "get": {
        "summary": "Takeout import state, files in the drop folder, options, log tail",
        "responses": {
          "200": {
            "description": "import"
          }
        }
      }
    },
    "/photos/api/import/options": {
      "get": {
        "summary": "Import options",
        "responses": {
          "200": {
            "description": "options"
          }
        }
      },
      "post": {
        "summary": "Change import options",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "include_archived": {
                    "type": "boolean"
                  },
                  "include_partner": {
                    "type": "boolean"
                  },
                  "sync_albums": {
                    "type": "boolean"
                  },
                  "include_trashed": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "options"
          }
        }
      }
    },
    "/photos/api/import/start": {
      "post": {
        "summary": "Start importing every Takeout file in Photos/Import",
        "responses": {
          "200": {
            "description": "started or why not"
          }
        }
      }
    },
    "/api/switches": {
      "get": {
        "summary": "wizard.app-switches/1",
        "responses": {
          "200": {
            "description": "switches"
          }
        }
      },
      "post": {
        "summary": "Set a switch",
        "responses": {
          "200": {
            "description": "switches"
          }
        }
      }
    },
    "/healthz": {
      "get": {
        "summary": "Front health and whether Immich answers",
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      }
    },
    "/photos/api/print-review": {
      "get": {
        "summary": "Monthly print review (switch print-review; 404 while off): a month's candidates, the suggested or saved set, its note, saved months",
        "parameters": [
          {
            "name": "month",
            "in": "query",
            "schema": {
              "type": "string",
              "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
            },
            "description": "default: last month"
          }
        ],
        "responses": {
          "200": {
            "description": "review"
          },
          "404": {
            "description": "switch off"
          }
        }
      },
      "post": {
        "summary": "Save the owner's approved set for a month with a short note (never orders anything)",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "month",
                  "assets"
                ],
                "properties": {
                  "month": {
                    "type": "string"
                  },
                  "assets": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "minItems": 1,
                    "maxItems": 30
                  },
                  "note": {
                    "type": "string",
                    "maxLength": 280
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "saved review"
          },
          "400": {
            "description": "invalid"
          },
          "404": {
            "description": "switch off"
          }
        }
      }
    },
    "/photos/api/print-review/thumb": {
      "get": {
        "summary": "A small picture of one photo for the review grid (switch print-review)",
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "image"
          },
          "404": {
            "description": "switch off"
          }
        }
      }
    }
  }
}
